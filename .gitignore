# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env

# Environment / secrets
.env
.env.local
.env.*.local
*.env

# Chika runtime data — everything under data/ except the intentionally-
# tracked seed files is generated state and gets ignored. Pattern: ignore
# the whole tree, then re-include the seeds with `!`.
memory_*.md
memory.md
data/*
!data/settings.json
profiles/
chika_cc_full.txt
top_files.py
*.log.*

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Playwright artefacts (regenerated every run). Visual baselines under
# *-snapshots/ stay tracked so screenshot regressions are caught.
frontend/test-results/
frontend/playwright-report/
extension/test-results/
extension/playwright-report/
docs/test-results/
docs/playwright-report/
docs/node_modules/
playwright/.cache/

# Variable-resolution leak: when an unresolved $variable reaches
# scaffold tools the path becomes the literal string "$app.path".
$app.path/

# Ad-hoc pytest / debug logs left at repo root
pytest_*.txt
pytest_*.log
pytest_inline.log

# IDE
.vscode/
.idea/
*.suo
*.user
*.sln.docstates

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Claude Code local config
.claude/

# Generated installer assets — chika.ico is rendered from
# docs/favicon.svg by installers/windows/make_icon.py at build time,
# so the canonical SVG and the installer icon never drift.
installers/windows/chika.ico
installers/dist/
