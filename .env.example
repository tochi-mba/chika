# ── Provider ──────────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | azure | ollama
CHIKA_PROVIDER=anthropic

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI ────────────────────────────────────────────────────────────────────
# CHIKA_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# CHIKA_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_API_VERSION=2024-10-21

# ── Ollama (local, free) ───────────────────────────────────────────────────────
# CHIKA_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1          # or qwen2.5, deepseek-r1, mistral, etc.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Engine ────────────────────────────────────────────────────────────────────
CHIKA_MAX_HISTORY_TOKENS=10000
CHIKA_MAX_WORKFLOW_STEPS=8
CHIKA_MAX_TOOL_TURNS=20
CHIKA_MAX_MEMORY_TOKENS=2000

# ── Thinking (Anthropic only) ─────────────────────────────────────────────────
CHIKA_THINKING=true
CHIKA_THINKING_BUDGET=4000

# ── Grounding / anti-hallucination ────────────────────────────────────────────
CHIKA_VALIDATE_RESPONSE=true
CHIKA_GROUNDING_MIN_LENGTH=160

# ── API server ────────────────────────────────────────────────────────────────
CHIKA_HOST=0.0.0.0
CHIKA_PORT=8000
CHIKA_API_KEY=
