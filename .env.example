# ─── Provider ───────────────────────────────────────────────────────────────
# Choose one: azure | anthropic | openai
CHIKA_PROVIDER=anthropic

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-10-21

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Engine ──────────────────────────────────────────────────────────────────
CHIKA_MAX_HISTORY_TOKENS=80000
CHIKA_MAX_TOOL_TURNS=20
CHIKA_MAX_MEMORY_TOKENS=2000

# ─── API Server ──────────────────────────────────────────────────────────────
CHIKA_HOST=0.0.0.0
CHIKA_PORT=8000

# API key for remote access. Leave blank to disable auth (local dev only).
# Set a strong random value when exposing to the internet.
CHIKA_API_KEY=

# ─── Spotify ─────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Set the Redirect URI to: http://localhost:8000/auth/spotify/callback
CHIKA_SPOTIFY_CLIENT_ID=
CHIKA_SPOTIFY_CLIENT_SECRET=

# OAuth tokens — populated automatically after visiting /auth/spotify
# Leave blank on first run; the agent will generate the auth URL for you.
CHIKA_SPOTIFY_ACCESS_TOKEN=
CHIKA_SPOTIFY_REFRESH_TOKEN=
# Override the callback URL for production/remote deployments
CHIKA_SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback
